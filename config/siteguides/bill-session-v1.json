{
  "schemaVersion": "agent-browser.siteguide.v1",
  "guideId": "bill-session-v1",
  "name": "BILL session verification starter template",
  "allowedOrigins": ["https://app.bill.com", "https://login.us.bill.com"],
  "authenticatedSelector": "[data-testid='app-shell']",
  "account": {"selector": "[data-testid='account-email']"},
  "organization": {"selector": "[data-testid='company-id']", "attribute": "data-company-id"},
  "states": [
    {"state": "identifier_required", "selector": "input[type=email]"},
    {"state": "password_required", "selector": "input[type=password]"},
    {"state": "mfa_required", "selector": "input[autocomplete=one-time-code]"}
  ]
}
