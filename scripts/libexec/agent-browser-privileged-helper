#!/usr/bin/env bash
set -euo pipefail

HELPER_VERSION="2026-09-19.p211-route-desktop-v6"

usage() {
  cat <<'EOF'
Usage: agent-browser-privileged-helper <command> [options]

Commands:
  check
  verify-install --group <group> --sudoers <path> --sha256 <digest> [--apparmor-profile-name <name>]
  status-json
  ensure-rdp-route-user --user <user>
  observe-rdp-route-session --user <user>
  terminate-rdp-route-session-exact [exact observed identity]
  restart-xrdp
  grant-display-access --operator-user <user> --route-user <user> --display <display>

This helper is intended to be installed root-owned under
/usr/local/libexec/agent-browser and called through a narrow sudoers rule.
EOF
}

require_root() {
  if [[ "$(id -u)" != "0" ]]; then
    echo "agent-browser-privileged-helper must run as root" >&2
    exit 2
  fi
}

require_route_user() {
  local user_name="$1"
  if [[ ! "$user_name" =~ ^agent-browser-rdp(-[a-z0-9][a-z0-9-]{0,30})?$ ]]; then
    echo "route user must be agent-browser-rdp or agent-browser-rdp-<suffix>" >&2
    exit 2
  fi
}

require_operator_user() {
  local user_name="$1"
  if [[ "$user_name" == "root" || ! "$user_name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo "operator user must be a non-root local username" >&2
    exit 2
  fi
  if ! getent passwd "$user_name" >/dev/null; then
    echo "operator user does not exist: $user_name" >&2
    exit 2
  fi
}

require_display_name() {
  local display_name="$1"
  if [[ ! "$display_name" =~ ^:[0-9]+(\.[0-9]+)?$ ]]; then
    echo "display must look like :10 or :10.0" >&2
    exit 2
  fi
}

verify_install() {
  require_root
  local group_name=""
  local sudoers_path=""
  local expected_sha256=""
  local apparmor_profile_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --group)
        group_name="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      --sudoers)
        sudoers_path="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      --sha256)
        expected_sha256="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      --apparmor-profile-name)
        apparmor_profile_name="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      *)
        echo "Unknown verify-install argument: $1" >&2
        exit 2
        ;;
    esac
  done

  if [[ ! "$group_name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo "verify-install requires a valid group" >&2
    exit 2
  fi
  if [[ "$sudoers_path" != */sudoers.d/agent-browser ]]; then
    echo "verify-install requires the agent-browser sudoers path" >&2
    exit 2
  fi
  if [[ ! "$expected_sha256" =~ ^[a-f0-9]{64}$ ]]; then
    echo "verify-install requires a SHA-256 digest" >&2
    exit 2
  fi
  if [[ -n "$apparmor_profile_name" && "$apparmor_profile_name" != "agent-browser-managed-chrome" ]]; then
    echo "verify-install requires the managed Chrome AppArmor profile name" >&2
    exit 2
  fi

  local helper_path
  helper_path="$(readlink -f "$0")"
  [[ "$(stat -c '%U:%G:%a' "$helper_path")" == "root:root:755" ]]
  [[ "$(sha256sum "$helper_path" | awk '{print $1}')" == "$expected_sha256" ]]
  [[ -f "$sudoers_path" ]]
  [[ "$(stat -c '%U:%G:%a' "$sudoers_path")" == "root:root:440" ]]
  printf '# agent-browser narrow privileged helper\n%%%s ALL=(root) NOPASSWD: %s\n' \
    "$group_name" "$helper_path" \
    | cmp -s - "$sudoers_path"
  if [[ -n "$apparmor_profile_name" ]]; then
    grep -Fqx "$apparmor_profile_name (unconfined)" /sys/kernel/security/apparmor/profiles
  fi
  echo "agent-browser privileged install verified"
}

display_socket_exists() {
  local display_number="$1"
  local display_socket="/tmp/.X11-unix/X$display_number"
  if [[ -S "$display_socket" ]]; then
    return 0
  fi
  if [[ -r /proc/net/unix ]] && grep -F "@/tmp/.X11-unix/X$display_number" /proc/net/unix >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

arg_value() {
  local name="$1"
  local value="${2:-}"
  if [[ -z "$value" ]]; then
    echo "$name requires a value" >&2
    exit 2
  fi
  printf '%s' "$value"
}

status_json() {
  local apparmor_profile_loaded="false"
  if [[ -r /sys/kernel/security/apparmor/profiles ]] \
    && grep -Fqx 'agent-browser-managed-chrome (unconfined)' /sys/kernel/security/apparmor/profiles; then
    apparmor_profile_loaded="true"
  fi
  cat <<EOF
{"schemaVersion":1,"helperVersion":"$HELPER_VERSION","routeDesktopSession":{"ready":true,"state":"browser_control_ready_template","terminalStartupDetected":false,"startsWindowManager":true,"keepsSessionAlive":true},"routeSessionObservation":{"supported":true,"exactCgroupV2Identity":true,"xServerProcessIdentity":true,"x11SocketOwnership":true},"routeSessionTermination":{"supported":true,"exactRouteUser":false,"idempotentWhenAbsent":false,"exactCgroupV2Identity":true,"retainedDirectoryIdentity":true,"usesCgroupKill":true,"broadUserTermination":false},"displayAccess":{"supportsFilesystemX11Socket":true,"supportsAbstractX11Socket":true,"boundedXhostTimeoutSeconds":2},"routeUserCredentialUpdate":{"pamBypassed":true,"cryptMethod":"SHA512","shaRounds":100000},"managedChromeSandboxPolicy":{"profileName":"agent-browser-managed-chrome","loaded":$apparmor_profile_loaded}}
EOF
}

write_xsession() {
  local user_name="$1"
  local home_dir="/home/$user_name"

  install -d -m 700 -o "$user_name" -g "$user_name" "$home_dir/.config/openbox"
  cat >"$home_dir/.xsession" <<'EOF'
#!/bin/sh
xsetroot -solid '#20252b' 2>/dev/null || true
if command -v openbox-session >/dev/null 2>&1; then
  openbox-session &
fi
while true; do
  sleep 3600
done
EOF
  chmod 700 "$home_dir/.xsession"
  chown "$user_name:$user_name" "$home_dir/.xsession"
}

ensure_rdp_route_user() {
  require_root
  local user_name=""
  local password=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        user_name="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      *)
        echo "Unknown ensure-rdp-route-user argument: $1" >&2
        exit 2
        ;;
    esac
  done

  if [[ -z "$user_name" ]]; then
    echo "ensure-rdp-route-user requires --user" >&2
    exit 2
  fi
  require_route_user "$user_name"

  IFS= read -r password || true
  if [[ -z "$password" ]]; then
    echo "ensure-rdp-route-user requires a password on stdin" >&2
    exit 2
  fi

  if ! getent passwd "$user_name" >/dev/null; then
    useradd --create-home --shell /bin/bash --comment "agent-browser route-pool RDP session" "$user_name"
  fi

  # chpasswd's default path uses PAM, which can invoke pam_gnome_keyring and
  # raise an interactive unlock prompt during unattended reconciliation.
  # Selecting the crypt method keeps the password on stdin while bypassing PAM.
  printf '%s:%s\n' "$user_name" "$password" \
    | chpasswd --crypt-method SHA512 --sha-rounds 100000
  usermod -aG ssl-cert "$user_name" >/dev/null 2>&1 || true
  usermod -aG ssl-cert xrdp >/dev/null 2>&1 || true
  write_xsession "$user_name"
  echo "ensured RDP route user $user_name"
}

helper_observation_roots() {
  PROC_ROOT="${AGENT_BROWSER_HELPER_TEST_PROC_ROOT:-/proc}"
  CGROUP_ROOT="${AGENT_BROWSER_HELPER_TEST_CGROUP_ROOT:-/sys/fs/cgroup}"
  BOOT_ID_PATH="${AGENT_BROWSER_HELPER_TEST_BOOT_ID_PATH:-/proc/sys/kernel/random/boot_id}"
  PROC_NET_UNIX_PATH="${AGENT_BROWSER_HELPER_TEST_PROC_NET_UNIX_PATH:-/proc/net/unix}"
  if [[ "$EUID" == "0" && ( "$PROC_ROOT" != "/proc" \
    || "$CGROUP_ROOT" != "/sys/fs/cgroup" \
    || "$BOOT_ID_PATH" != "/proc/sys/kernel/random/boot_id" \
    || "$PROC_NET_UNIX_PATH" != "/proc/net/unix" ) ]]; then
    echo "test observation roots are forbidden for a root helper" >&2
    exit 2
  fi
}

managed_route_uid() {
  local user_name="$1"
  local passwd_entry
  passwd_entry="$(timeout --signal=KILL 2s getent passwd "$user_name" || true)"
  if [[ -z "$passwd_entry" ]]; then
    echo "route user does not exist: $user_name" >&2
    exit 2
  fi
  local account_name _password uid _gid comment home_dir shell
  IFS=: read -r account_name _password uid _gid comment home_dir shell <<<"$passwd_entry"
  if [[ "$account_name" != "$user_name" \
    || ! "$uid" =~ ^[1-9][0-9]*$ \
    || "$comment" != "agent-browser route-pool RDP session" \
    || "$home_dir" != "/home/$user_name" \
    || "$shell" != "/bin/bash" ]]; then
    echo "route user identity drifted: $user_name" >&2
    exit 2
  fi
  printf '%s' "$uid"
}

process_start_ticks() {
  local pid="$1"
  local stat_line remainder
  stat_line="$(<"$PROC_ROOT/$pid/stat")" || return 1
  remainder="${stat_line##*) }"
  local fields=()
  read -r -a fields <<<"$remainder"
  [[ "${#fields[@]}" -ge 20 && "${fields[19]}" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s' "${fields[19]}"
}

process_uid() {
  awk '$1 == "Uid:" { print $2; exit }' "$PROC_ROOT/$1/status"
}

process_cgroup_path() {
  local lines
  lines="$(<"$PROC_ROOT/$1/cgroup")" || return 1
  [[ "$lines" != *$'\n'* && "$lines" == 0::* ]] || return 1
  printf '%s' "${lines#0::}"
}

emit_route_session_state() {
  local state="$1"
  local code="$2"
  printf '{"schemaVersion":1,"state":"%s","code":"%s"}\n' "$state" "$code"
}

route_session_witness_digest() {
  printf 'agent-browser.route-keeper-xrdp-ownership.v1\n%s\n%s\n%s\n%s\nxrdp-sesman\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$W_BOOT_ID" "$W_ROUTE_USER" "$W_ROUTE_UID" "$W_SESSION_ID" "$W_SESSION_SCOPE" \
    "$W_SCOPE_INVOCATION_ID" "$W_CGROUP_PATH" "$W_CGROUP_DEVICE" "$W_CGROUP_INODE" \
    "$W_LEADER_PID" "$W_LEADER_START_TICKS" "$W_X_SERVER_PID" "$W_X_SERVER_START_TICKS" \
    "$W_DISPLAY_NAME" "$W_X11_SOCKET_INODE" \
    | sha256sum | awk '{ print $1 }'
}

collect_rdp_route_session() {
  local user_name="$1"
  helper_observation_roots
  require_route_user "$user_name"
  W_ROUTE_USER="$user_name"
  W_ROUTE_UID="$(managed_route_uid "$user_name")"
  W_BOOT_ID="$(<"$BOOT_ID_PATH")" || return 1
  [[ "$W_BOOT_ID" =~ ^[a-fA-F0-9-]{16,64}$ ]] || return 1

  local session_output
  session_output="$(timeout --signal=KILL 2s loginctl list-sessions --no-legend --no-pager)" \
    || return 1
  local candidates=()
  local session_id session_uid session_user _rest
  while read -r session_id session_uid session_user _rest; do
    [[ -n "${session_id:-}" ]] || continue
    if [[ "$session_uid" == "$W_ROUTE_UID" && "$session_user" == "$user_name" ]]; then
      candidates+=("$session_id")
    fi
  done <<<"$session_output"
  if [[ "${#candidates[@]}" == "0" ]]; then
    W_STATE="pending"
    W_CODE="rdp_route_session_absent"
    return 0
  fi
  if [[ "${#candidates[@]}" != "1" ]]; then
    W_STATE="ownership_unproven"
    W_CODE="rdp_route_session_ambiguous"
    return 0
  fi
  W_SESSION_ID="${candidates[0]}"
  [[ "$W_SESSION_ID" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || return 1

  local properties_output
  properties_output="$(timeout --signal=KILL 2s loginctl show-session "$W_SESSION_ID" \
    --property=Name --property=User --property=Service --property=Type \
    --property=State --property=Leader --property=Scope)" || return 1
  declare -A properties=()
  local line key value
  while IFS='=' read -r key value; do
    [[ -n "$key" && -z "${properties[$key]+set}" ]] || return 1
    case "$key" in
      Name|User|Service|Type|State|Leader|Scope) properties[$key]="$value" ;;
      *) return 1 ;;
    esac
  done <<<"$properties_output"
  for key in Name User Service Type State Leader Scope; do
    [[ -n "${properties[$key]:-}" ]] || return 1
  done
  if [[ "${properties[Name]}" != "$user_name" \
    || "${properties[User]}" != "$W_ROUTE_UID" \
    || "${properties[Service]}" != "xrdp-sesman" \
    || "${properties[Type]}" != "x11" \
    || "${properties[State]}" != "active" ]]; then
    W_STATE="ownership_unproven"
    W_CODE="rdp_route_session_properties_mismatch"
    return 0
  fi
  W_LEADER_PID="${properties[Leader]}"
  W_SESSION_SCOPE="${properties[Scope]}"
  [[ "$W_LEADER_PID" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$W_SESSION_SCOPE" == "session-$W_SESSION_ID.scope" ]] || return 1
  W_CGROUP_PATH="/user.slice/user-$W_ROUTE_UID.slice/$W_SESSION_SCOPE"
  [[ "$(process_uid "$W_LEADER_PID")" == "$W_ROUTE_UID" ]] || return 1
  [[ "$(process_cgroup_path "$W_LEADER_PID")" == "$W_CGROUP_PATH" ]] || return 1
  W_LEADER_START_TICKS="$(process_start_ticks "$W_LEADER_PID")" || return 1

  W_SCOPE_INVOCATION_ID="$(timeout --signal=KILL 2s systemctl show "$W_SESSION_SCOPE" --property=InvocationID --value)" \
    || return 1
  [[ "$W_SCOPE_INVOCATION_ID" =~ ^[a-fA-F0-9]{32}$ ]] || return 1
  local cgroup_target="$CGROUP_ROOT$W_CGROUP_PATH"
  [[ -d "$cgroup_target" && -f "$CGROUP_ROOT/cgroup.controllers" ]] || return 1
  IFS=: read -r W_CGROUP_DEVICE W_CGROUP_INODE < <(stat -Lc '%d:%i' "$cgroup_target")
  [[ "$W_CGROUP_DEVICE" =~ ^[1-9][0-9]*$ && "$W_CGROUP_INODE" =~ ^[1-9][0-9]*$ ]] || return 1

  local xserver_candidates=()
  local process_path pid cmdline display
  for process_path in "$PROC_ROOT"/[0-9]*; do
    [[ -d "$process_path" ]] || continue
    pid="${process_path##*/}"
    [[ "$(process_uid "$pid" 2>/dev/null || true)" == "$W_ROUTE_UID" ]] || continue
    [[ "$(process_cgroup_path "$pid" 2>/dev/null || true)" == "$W_CGROUP_PATH" ]] || continue
    cmdline="$(tr '\0' ' ' <"$process_path/cmdline" 2>/dev/null || true)"
    if [[ " $cmdline " =~ [[:space:]]([^[:space:]]*/)?Xorg[[:space:]]+(:[0-9]+)([[:space:]]|$) ]]; then
      display="${BASH_REMATCH[2]}"
      xserver_candidates+=("$pid:$display")
    fi
  done
  if [[ "${#xserver_candidates[@]}" != "1" ]]; then
    W_STATE="ownership_unproven"
    W_CODE="rdp_route_xserver_ambiguous"
    return 0
  fi
  W_X_SERVER_PID="${xserver_candidates[0]%%:*}"
  W_DISPLAY_NAME="${xserver_candidates[0]#*:}"
  W_X_SERVER_START_TICKS="$(process_start_ticks "$W_X_SERVER_PID")" || return 1

  local display_number="${W_DISPLAY_NAME#:}"
  W_X11_SOCKET_INODE=""
  local matching_socket_count=0
  local inode socket_path fd target socket_owned
  while read -r _num _ref _protocol _flags _type _state inode socket_path; do
    [[ "${socket_path:-}" == "/tmp/.X11-unix/X$display_number" \
      || "${socket_path:-}" == "@/tmp/.X11-unix/X$display_number" ]] || continue
    if [[ ! "$_flags" =~ ^[0-9a-fA-F]+$ ]]; then
      W_STATE="ownership_unproven"
      W_CODE="rdp_route_x11_socket_invalid"
      return 0
    fi
    (( (16#$_flags & 16#10000) != 0 )) || continue
    if [[ ! "$inode" =~ ^[1-9][0-9]*$ || ! "$_type" =~ ^0*1$ || "$_state" != "01" ]]; then
      W_STATE="ownership_unproven"
      W_CODE="rdp_route_x11_socket_invalid"
      return 0
    fi
    matching_socket_count=$((matching_socket_count + 1))
    socket_owned="false"
    for fd in "$PROC_ROOT/$W_X_SERVER_PID/fd/"*; do
      target="$(readlink "$fd" 2>/dev/null || true)"
      if [[ "$target" == "socket:[$inode]" ]]; then
        socket_owned="true"
        break
      fi
    done
    if [[ "$socket_owned" != "true" ]]; then
      W_STATE="ownership_unproven"
      W_CODE="rdp_route_x11_socket_owner_mismatch"
      return 0
    fi
    if [[ -z "$W_X11_SOCKET_INODE" || "$inode" -lt "$W_X11_SOCKET_INODE" ]]; then
      W_X11_SOCKET_INODE="$inode"
    fi
  done <"$PROC_NET_UNIX_PATH"
  [[ "$matching_socket_count" -gt 0 && "$W_X11_SOCKET_INODE" =~ ^[1-9][0-9]*$ ]] || return 1

  [[ "$(process_start_ticks "$W_LEADER_PID")" == "$W_LEADER_START_TICKS" ]] || return 1
  [[ "$(process_cgroup_path "$W_LEADER_PID")" == "$W_CGROUP_PATH" ]] || return 1
  [[ "$(process_start_ticks "$W_X_SERVER_PID")" == "$W_X_SERVER_START_TICKS" ]] || return 1
  [[ "$(process_cgroup_path "$W_X_SERVER_PID")" == "$W_CGROUP_PATH" ]] || return 1
  W_STATE="ready"
  W_CODE=""
}

observe_rdp_route_session() {
  require_root
  local user_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        user_name="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      *)
        echo "Unknown observe-rdp-route-session argument: $1" >&2
        exit 2
        ;;
    esac
  done

  if [[ -z "$user_name" ]]; then
    echo "observe-rdp-route-session requires --user" >&2
    exit 2
  fi
  if ! collect_rdp_route_session "$user_name"; then
    emit_route_session_state "ownership_unproven" "rdp_route_session_evidence_invalid"
    return 0
  fi
  if [[ "$W_STATE" != "ready" ]]; then
    emit_route_session_state "$W_STATE" "$W_CODE"
    return 0
  fi
  printf '{"schemaVersion":1,"state":"ready","witness":{"schemaVersion":"agent-browser.route-keeper-xrdp-ownership.v1","bootId":"%s","routeUser":"%s","routeUid":%s,"sessionId":"%s","sessionService":"xrdp-sesman","sessionScope":"%s","scopeInvocationId":"%s","cgroupPath":"%s","cgroupDevice":%s,"cgroupInode":%s,"leaderPid":%s,"leaderStartTicks":%s,"xServerPid":%s,"xServerStartTicks":%s,"displayName":"%s","x11SocketInode":%s}}\n' \
    "$W_BOOT_ID" "$W_ROUTE_USER" "$W_ROUTE_UID" "$W_SESSION_ID" "$W_SESSION_SCOPE" \
    "$W_SCOPE_INVOCATION_ID" "$W_CGROUP_PATH" "$W_CGROUP_DEVICE" "$W_CGROUP_INODE" \
    "$W_LEADER_PID" "$W_LEADER_START_TICKS" "$W_X_SERVER_PID" "$W_X_SERVER_START_TICKS" \
    "$W_DISPLAY_NAME" "$W_X11_SOCKET_INODE"
}

terminate_rdp_route_session_exact() {
  require_root
  local user_name="" session_id="" boot_id="" scope_invocation_id=""
  local cgroup_device="" cgroup_inode="" leader_pid="" leader_start_ticks=""
  local x_server_pid="" x_server_start_ticks="" display_name="" x11_socket_inode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user) user_name="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --session-id) session_id="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --boot-id) boot_id="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --scope-invocation-id) scope_invocation_id="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --cgroup-device) cgroup_device="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --cgroup-inode) cgroup_inode="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --leader-pid) leader_pid="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --leader-start-ticks) leader_start_ticks="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --x-server-pid) x_server_pid="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --x-server-start-ticks) x_server_start_ticks="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --display) display_name="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      --x11-socket-inode) x11_socket_inode="$(arg_value "$1" "${2:-}")"; shift 2 ;;
      *) echo "Unknown terminate-rdp-route-session-exact argument: $1" >&2; exit 2 ;;
    esac
  done
  if [[ -z "$user_name" || -z "$session_id" || -z "$boot_id" \
    || -z "$scope_invocation_id" || -z "$cgroup_device" || -z "$cgroup_inode" \
    || -z "$leader_pid" || -z "$leader_start_ticks" || -z "$x_server_pid" \
    || -z "$x_server_start_ticks" || -z "$display_name" || -z "$x11_socket_inode" ]]; then
    echo "terminate-rdp-route-session-exact requires the complete observed identity" >&2
    exit 2
  fi
  if ! collect_rdp_route_session "$user_name" || [[ "$W_STATE" != "ready" ]]; then
    emit_route_session_state "ownership_unproven" "rdp_route_session_reobservation_failed"
    return 0
  fi
  if [[ "$W_SESSION_ID" != "$session_id" || "$W_BOOT_ID" != "$boot_id" \
    || "$W_SCOPE_INVOCATION_ID" != "$scope_invocation_id" \
    || "$W_CGROUP_DEVICE" != "$cgroup_device" || "$W_CGROUP_INODE" != "$cgroup_inode" \
    || "$W_LEADER_PID" != "$leader_pid" || "$W_LEADER_START_TICKS" != "$leader_start_ticks" \
    || "$W_X_SERVER_PID" != "$x_server_pid" \
    || "$W_X_SERVER_START_TICKS" != "$x_server_start_ticks" \
    || "$W_DISPLAY_NAME" != "$display_name" || "$W_X11_SOCKET_INODE" != "$x11_socket_inode" ]]; then
    emit_route_session_state "ownership_unproven" "rdp_route_session_identity_changed"
    return 0
  fi

  local scope_fd
  exec {scope_fd}<"$CGROUP_ROOT$W_CGROUP_PATH"
  local retained_device retained_inode
  IFS=: read -r retained_device retained_inode < <(stat -Lc '%d:%i' "/proc/self/fd/$scope_fd")
  if [[ "$retained_device" != "$cgroup_device" || "$retained_inode" != "$cgroup_inode" ]]; then
    exec {scope_fd}<&-
    emit_route_session_state "ownership_unproven" "rdp_route_session_cgroup_identity_changed"
    return 0
  fi
  printf '1\n' >"/proc/self/fd/$scope_fd/cgroup.kill"
  sleep 0.05
  local attempts=0 populated="1"
  while [[ "$attempts" -lt 30 ]]; do
    populated="$(awk '$1 == "populated" { print $2; exit }' "/proc/self/fd/$scope_fd/cgroup.events" 2>/dev/null || true)"
    [[ "$populated" == "0" ]] && break
    attempts=$((attempts + 1))
    sleep 0.1
  done
  if [[ "$populated" != "0" ]] \
    || ! process_instance_gone_or_replaced "$leader_pid" "$leader_start_ticks" \
    || ! process_instance_gone_or_replaced "$x_server_pid" "$x_server_start_ticks"; then
    exec {scope_fd}<&-
    emit_route_session_state "incomplete" "rdp_route_session_scope_not_empty"
    return 0
  fi
  exec {scope_fd}<&-
  local witness_digest
  witness_digest="$(route_session_witness_digest)"
  printf '{"schemaVersion":1,"state":"stopped","witnessDigest":"%s","verification":{"sessionInstanceAbsent":true,"xServerInstanceAbsent":true,"ownedScopeEmptyOrAbsent":true}}\n' "$witness_digest"
}

process_instance_gone_or_replaced() {
  local pid="$1"
  local expected_start_ticks="$2"
  if [[ ! -d "$PROC_ROOT/$pid" ]]; then
    return 0
  fi
  local current_start_ticks
  current_start_ticks="$(process_start_ticks "$pid")" || return 1
  [[ "$current_start_ticks" != "$expected_start_ticks" ]]
}

restart_xrdp() {
  require_root
  systemctl restart xrdp-sesman xrdp
  echo "restarted xrdp-sesman and xrdp"
}

grant_display_access() {
  require_root
  local operator_user=""
  local route_user=""
  local display_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --operator-user)
        operator_user="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      --route-user)
        route_user="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      --display)
        display_name="$(arg_value "$1" "${2:-}")"
        shift 2
        ;;
      *)
        echo "Unknown grant-display-access argument: $1" >&2
        exit 2
        ;;
    esac
  done

  if [[ -z "$operator_user" || -z "$route_user" || -z "$display_name" ]]; then
    echo "grant-display-access requires --operator-user, --route-user, and --display" >&2
    exit 2
  fi
  require_operator_user "$operator_user"
  require_route_user "$route_user"
  require_display_name "$display_name"
  if ! getent passwd "$route_user" >/dev/null; then
    echo "route user does not exist: $route_user" >&2
    exit 2
  fi

  local xauthority="/home/$route_user/.Xauthority"
  local display_number="${display_name#:}"
  if ! display_socket_exists "$display_number"; then
    echo "display socket does not exist for $display_name: /tmp/.X11-unix/X$display_number or @/tmp/.X11-unix/X$display_number" >&2
    exit 1
  fi
  local status=0
  timeout --kill-after=1 2s runuser -u "$route_user" -- env DISPLAY="$display_name" XAUTHORITY="$xauthority" \
    xhost "+SI:localuser:$operator_user" || status=$?
  if [[ "$status" != "0" ]]; then
    if [[ "$status" == "124" || "$status" == "137" ]]; then
      echo "timed out granting $operator_user local X access on $display_name for $route_user" >&2
    else
      echo "failed to grant $operator_user local X access on $display_name for $route_user" >&2
    fi
    exit "$status"
  fi
  echo "granted $operator_user local X access on $display_name for $route_user"
}

case "${1:-}" in
  check)
    require_root
    echo "agent-browser privileged helper ready"
    ;;
  verify-install)
    shift
    verify_install "$@"
    ;;
  status-json)
    status_json
    ;;
  ensure-rdp-route-user)
    shift
    ensure_rdp_route_user "$@"
    ;;
  observe-rdp-route-session)
    shift
    observe_rdp_route_session "$@"
    ;;
  terminate-rdp-route-session-exact)
    shift
    terminate_rdp_route_session_exact "$@"
    ;;
  restart-xrdp)
    shift
    restart_xrdp "$@"
    ;;
  grant-display-access)
    shift
    grant_display_access "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
