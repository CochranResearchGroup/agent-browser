name: CI

# Dormant while this file has the `.disabled` suffix.
on:
  pull_request:
    branches: [main]

permissions:
  actions: read
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  classify:
    name: Validation Selection
    runs-on: ubuntu-latest
    outputs:
      selection: ${{ steps.selection.outputs.selection }}
      tier: ${{ steps.selection.outputs.tier }}
      docs: ${{ steps.selection.outputs.docs }}
      version_sync: ${{ steps.selection.outputs.version_sync }}
      rust_quality: ${{ steps.selection.outputs.rust_quality }}
      rust: ${{ steps.selection.outputs.rust }}
      dashboard: ${{ steps.selection.outputs.dashboard }}
      service_client: ${{ steps.selection.outputs.service_client }}
      repository_tooling: ${{ steps.selection.outputs.repository_tooling }}
      service_smokes: ${{ steps.selection.outputs.service_smokes }}
      workstation: ${{ steps.selection.outputs.workstation }}
      rust_compartments: ${{ steps.selection.outputs.rust_compartments }}
      base: ${{ steps.selection.outputs.base }}
      head: ${{ steps.selection.outputs.head }}
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v5
        with:
          version: 10

      - name: Classify changed surfaces
        id: selection
        shell: bash
        run: |
          set -euo pipefail
          head_sha="${{ github.event.pull_request.head.sha || github.sha }}"
          base_sha="${{ github.event.pull_request.base.sha }}"
          if ! git cat-file -e "${base_sha}^{commit}" 2>/dev/null; then
            base_sha="$(git rev-list --max-parents=0 "$head_sha" | tail -n 1)"
          fi
          git diff --check "${base_sha}...${head_sha}"
          node scripts/dev/select-validation.js \
            --base "$base_sha" \
            --head "$head_sha" \
            --ci \
            --json \
            --github-output "$GITHUB_OUTPUT" | tee validation-selection.json
          {
            echo '## Validation selection'
            echo
            echo "- Tier: \`$(jq -r .tier validation-selection.json)\`"
            echo "- Changed files: $(jq '.changedFiles | length' validation-selection.json)"
            echo "- Selected jobs: $(jq -r '.jobs | to_entries | map(select(.value) | .key) | join(", ")' validation-selection.json)"
            echo "- Exclusions: $(jq -r '.exclusions | join(", ")' validation-selection.json)"
            echo "- Unknown files: $(jq -r '.unknownFiles | join(", ")' validation-selection.json)"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Test validation control plane
        run: pnpm run test:validation-selection

      - name: Upload validation selection
        uses: actions/upload-artifact@v4
        with:
          name: validation-selection
          path: validation-selection.json

  docs:
    name: Documentation
    needs: classify
    if: needs.classify.outputs.docs == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v5
        with:
          version: 10

      - name: Install documentation dependency slice
        run: pnpm install --frozen-lockfile --filter docs

      - name: Check policy and planning contracts
        run: |
          pnpm test:policy-wiring
          python .codex/skills/repo-policy-selector/scripts/audit_planning_contract.py --repo-root . --active-only

      - name: Check changed documentation links
        run: node scripts/check-documentation-links.js --base "${{ needs.classify.outputs.base }}" --head "${{ needs.classify.outputs.head }}"

      - name: Build documentation site
        run: pnpm --dir docs build

  version-sync:
    name: Version Sync Check
    needs: classify
    if: needs.classify.outputs.version_sync == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Check version sync
        run: node scripts/check-version-sync.js

  rust-quality:
    name: Rust Quality
    needs: classify
    if: needs.classify.outputs.rust_quality == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Rust toolchain
        uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy

      - name: Cache Rust build artifacts
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: .

      - name: Format check
        run: cargo fmt --all --manifest-path Cargo.toml -- --check

      - name: Clippy check
        run: cargo clippy --workspace --manifest-path Cargo.toml -- -D warnings

  rust-tests:
    name: Rust
    runs-on: ubuntu-latest
    needs: [classify, rust-quality]
    if: needs.classify.outputs.rust == 'true'
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v5
        with:
          version: 10

      - name: Cache Rust build artifacts
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: .

      - name: Run affected Rust compartments
        env:
          RUST_COMPARTMENTS: ${{ needs.classify.outputs.rust_compartments }}
        run: |
          mapfile -t compartments < <(jq -r '.[]' <<< "$RUST_COMPARTMENTS")
          cli_compartments=()
          support_compartments=()
          for compartment in "${compartments[@]}"; do
            if [[ "$compartment" == cli-* ]]; then
              cli_compartments+=("$compartment")
            else
              support_compartments+=("$compartment")
            fi
          done
          run_lane() {
            local lane_status=0
            for compartment in "$@"; do
              scripts/ci/rust-tests.sh --compartment "$compartment" || lane_status=1
            done
            return "$lane_status"
          }
          set +e
          run_lane "${cli_compartments[@]}" &
          cli_pid=$!
          run_lane "${support_compartments[@]}" &
          support_pid=$!
          wait "$cli_pid"
          cli_status=$?
          wait "$support_pid"
          support_status=$?
          set -e
          if [[ "$cli_status" -ne 0 || "$support_status" -ne 0 ]]; then
            exit 1
          fi
        timeout-minutes: 30

      - name: Run no-launch service smokes
        if: needs.classify.outputs.service_smokes == 'true'
        run: |
          pnpm test:service-status-fixed-input-harness
          scripts/ci/cargo-safe.sh build --manifest-path cli/Cargo.toml
          export AGENT_BROWSER_SMOKE_AGENT_BROWSER_CMD="$PWD/cli/target/debug/agent-browser"
          node scripts/smoke-service-contracts-no-launch.js
          node scripts/smoke-mcp-read-no-launch.js
          node scripts/smoke-service-profile-sources.js
          node scripts/smoke-service-site-policy-sources.js
          node scripts/smoke-service-remedies-cli-no-launch.js
          node scripts/smoke-service-remedies-json-no-launch.js
          node scripts/smoke-service-remedies-apply-json-no-launch.js
          node scripts/smoke-service-incident-summary-http.js
          node scripts/smoke-service-incident-summary-mcp.js
        timeout-minutes: 10

  dashboard:
    name: Dashboard
    needs: classify
    if: needs.classify.outputs.dashboard == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v5
        with:
          version: 10

      - name: Install dependencies
        run: pnpm install --filter dashboard
        working-directory: packages/dashboard

      - name: Test dashboard contracts
        run: pnpm test:dashboard-incident-summary

      - name: Build dashboard
        run: pnpm build
        working-directory: packages/dashboard

  service-client:
    name: Service Client
    needs: classify
    if: needs.classify.outputs.service_client == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v5
        with:
          version: 10

      - name: Install service client dependency slice
        run: pnpm install --frozen-lockfile --filter docs --filter agent-browser-service-client-example

      - name: Test browser capability registry draft
        run: pnpm test:browser-capability-registry-draft

      - name: Test service client contracts
        run: pnpm test:service-client

  repository-tooling:
    name: Repository Tooling
    needs: classify
    if: needs.classify.outputs.repository_tooling == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Install pnpm
        uses: pnpm/action-setup@v5
        with:
          version: 10

      - name: Test repository tooling contracts
        run: pnpm test:repository-tooling

  workstation-fixtures:
    name: Workstation Fixtures
    needs: classify
    if: needs.classify.outputs.workstation == 'true'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22

      - name: Setup Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Cache Rust build artifacts
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: .

      - name: Build exact-head fixture binary
        run: cargo build --manifest-path cli/Cargo.toml

      - name: Test source-free workstation installation
        run: node scripts/test-workstation-install-fixture.js
        env:
          AGENT_BROWSER_FIXTURE_BIN: cli/target/debug/agent-browser

      - name: Test workstation host provisioning
        run: bash scripts/smoke-install-workstation-host-fixture.sh

      - name: Test fresh workstation VM harness
        run: node scripts/test-fresh-workstation-vm-harness.js

      - name: Test pinned Guacamole assets
        run: node scripts/test-workstation-guacamole-assets.js

      - name: Test PostgreSQL durability and hardening
        run: |
          node scripts/test-guacamole-postgres-durability.js
          node scripts/test-rdp-guac-postgres-hardening.js

      - name: Test route user synchronization
        run: node scripts/test-rdp-guac-route-specific-user-sync.js

      - name: Test release asset and changelog verification
        run: bash scripts/release/test-verify-release-assets.sh

  presubmit:
    name: Presubmit
    if: always()
    needs:
      - classify
      - docs
      - version-sync
      - rust-quality
      - rust-tests
      - dashboard
      - service-client
      - repository-tooling
      - workstation-fixtures
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact head
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.classify.outputs.head || github.sha }}

      - name: Verify selected jobs
        shell: bash
        env:
          VALIDATION_SELECTION_JSON: ${{ needs.classify.outputs.selection }}
          VALIDATION_RESULTS_JSON: >-
            {"docs":"${{ needs.docs.result }}","versionSync":"${{ needs['version-sync'].result }}","rustQuality":"${{ needs['rust-quality'].result }}","rust":"${{ needs['rust-tests'].result }}","dashboard":"${{ needs.dashboard.result }}","serviceClient":"${{ needs['service-client'].result }}","repositoryTooling":"${{ needs['repository-tooling'].result }}","workstation":"${{ needs['workstation-fixtures'].result }}"}
        run: |
          set -euo pipefail
          node scripts/ci/verify-presubmit.js | tee presubmit-receipt.json

      - name: Record validation economics
        if: always()
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          VALIDATION_SELECTION_JSON: ${{ needs.classify.outputs.selection }}
          VALIDATION_JOBS_PATH: validation-jobs.json
        run: |
          set -euo pipefail
          gh api "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/jobs?per_page=100" > "$VALIDATION_JOBS_PATH"
          node scripts/ci/report-validation-economics.js | tee validation-economics.json

      - name: Upload presubmit receipts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: presubmit-receipts
          path: |
            presubmit-receipt.json
            validation-economics.json
