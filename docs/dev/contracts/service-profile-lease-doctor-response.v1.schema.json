{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/service-profile-lease-doctor-response.v1.schema.json",
  "title": "agent-browser service profile lease doctor response",
  "type": "object",
  "required": ["doctor"],
  "properties": {
    "doctor": {
      "type": "object",
      "required": ["schemaVersion", "observedAt", "healthy", "leaseCount", "findings"],
      "properties": {
        "schemaVersion": { "const": "agent-browser.profile-lease.v1" },
        "observedAt": { "type": "string", "format": "date-time" },
        "healthy": { "type": "boolean" },
        "leaseCount": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "leaseId", "profileId", "message", "safeActions"],
            "properties": {
              "code": { "type": "string" },
              "severity": { "type": "string", "enum": ["warning", "error"] },
              "leaseId": { "type": "string" },
              "profileId": { "type": "string" },
              "message": { "type": "string" },
              "safeActions": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
