    }
  ],
  "recipes": {
    "capacity": {
      "rationale": "Active admission must preserve unresolved originals and duplicate protection within the configured ceiling.",
      "requiredActor": "task_policy_owner",
      "evidenceRequirement": "Current capacity usage, eligible archive count and effective task/system policy.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "operation": "capacity"
          }
        }
      },
      "remediation": [
        {
          "instruction": "Increase the existing task policy only within authorized operational limits. Supply the reviewed complete policy to the same capacity operation; do not delete originals.",
          "call": {
            "tool": "browser_command",
            "arguments": {
              "taskId": "$taskId",
              "action": "task_operation",
              "params": {
                "operation": "capacity",
                "scope": "task",
                "policy": "$reviewedPolicy"
              }
            }
          },
          "precondition": "Caller has authority for the operational policy and reviewedPolicy is complete."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "operation": "capacity"
          }
        }
      },
      "resumeCondition": "Capacity reports room; unresolved originals remain retained. Continue the previously refused no-effect action on the same task.",
      "maximumAutomaticAttempts": 1
    },
    "invalid_request": {
      "rationale": "The original request does not satisfy the named task-operation argument contract.",
      "requiredActor": "caller",
      "evidenceRequirement": "Original argument shape and current public browser_command schema.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_briefing"
        }
      },
      "remediation": [
        {
          "instruction": "Correct only the invalid field identified by the specific code. Keep an existing request ID bound to its original arguments; conflicting changes require resolving the original first.",
          "interface": "original_public_request",
          "precondition": "Original response establishes no effect or original request has been reconciled."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "requestId": "$requestId"
          }
        }
      },
      "resumeCondition": "The corrected request satisfies the public schema and any retained original is reconciled; do not mutate an existing request ID.",
      "maximumAutomaticAttempts": 1
    },
    "original": {
      "rationale": "A retained original or changed identity prevents safely treating a new input as an unexecuted request.",
      "requiredActor": "caller",
      "evidenceRequirement": "Original task-operation outcome and current physical browser/tab identity.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "requestId": "$requestId"
          }
        }
      },
      "remediation": [
        {
          "instruction": "Reconcile the original outcome against the retained task briefing. A changed or uncertain original never authorizes replay or a replacement request ID. Escalate missing original proof with the occurrence and original IDs.",
          "call": {
            "tool": "browser_command",
            "arguments": {
              "taskId": "$taskId",
              "action": "task_briefing"
            }
          },
          "precondition": "Use the same task and original request IDs."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "requestId": "$requestId"
          }
        }
      },
      "resumeCondition": "Original outcome is settled and current target identity is verified. Continue independent reads while uncertain input remains fenced.",
      "maximumAutomaticAttempts": 1
    },
    "storage": {
      "rationale": "Archive, fingerprint key or durable state failure prevents proving the retained duplicate/effect contract.",
      "requiredActor": "installation_owner",
      "evidenceRequirement": "Exact original lookup outcome and durable store diagnostics; absence of a read result does not prove absence of the operation.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "requestId": "$requestId"
          }
        }
      },
      "remediation": [
        {
          "instruction": "Preserve the durable store and its original fingerprint key. Repair the identified storage availability/permissions under installation-owner authority; retain an escalation packet if corruption or identity proof remains unresolved. Never regenerate the key or delete history as recovery.",
          "interface": "installation_owner_storage_repair",
          "precondition": "No browser input retry and no destructive store mutation."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "requestId": "$requestId"
          }
        }
      },
      "resumeCondition": "The same original is readable with intact identity and protection. Resume only after its outcome is reconciled.",
      "maximumAutomaticAttempts": 1
    },
    "identity": {
      "rationale": "Physical task/browser/tab identity must be proven before dispatch; stale metadata alone is not authority to adopt a process.",
      "requiredActor": "caller",
      "evidenceRequirement": "Fresh mode proof and retained briefing from the exact task.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "mode"
        }
      },
      "remediation": [
        {
          "instruction": "Refresh mode and briefing. If retained proof is missing, use the supported explicit mode-conversion prepare/confirm workflow after resolving original inputs; do not adopt an unrelated process.",
          "call": {
            "tool": "browser_command",
            "arguments": {
              "taskId": "$taskId",
              "action": "task_briefing"
            }
          },
          "precondition": "Current taskId is retained and caller has conversion authority."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "mode"
        }
      },
      "resumeCondition": "Current physical identity is verified and original inputs are settled. Resume the same task without bypassing identity checks.",
      "maximumAutomaticAttempts": 1
    },
    "clock": {
      "rationale": "This action requires qualified elapsed/freshness evidence; guest time cannot establish it.",
      "requiredActor": "service_operator",
      "evidenceRequirement": "Current reliable-time availability and the actual client/helper failure, separately.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_briefing"
        }
      },
      "remediation": [
        {
          "instruction": "Restore the supported StableTime client/API or its configuration according to the actual failure. Continue independent reads; acquire fresh observation after reliable time returns.",
          "interface": "supported_stable_time_service",
          "precondition": "No guest-clock substitution; a helper failure is not proof of a service outage."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "mode"
        }
      },
      "resumeCondition": "Required reliable-time observation qualifies and the action obtains fresh target evidence; retained originals remain unchanged.",
      "maximumAutomaticAttempts": 1
    },
    "login_budget": {
      "rationale": "Continuation history is bounded by effective task maximumLoginSteps while acknowledged inputs retain their original identity.",
      "requiredActor": "task_policy_owner",
      "evidenceRequirement": "Current task capacity policy and acknowledged login episode steps.",
      "inspect": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "operation": "capacity"
          }
        }
      },
      "remediation": [
        {
          "instruction": "Review and increase policy.maximumLoginSteps using the existing task capacity policy; preserve all other policy fields and the same episode.",
          "call": {
            "tool": "browser_command",
            "arguments": {
              "taskId": "$taskId",
              "action": "task_operation",
              "params": {
                "operation": "capacity",
                "scope": "task",
                "policy": "$reviewedPolicy"
              }
            }
          },
          "precondition": "Existing inputs are owner-acknowledged and caller has policy authority."
        }
      ],
      "verification": {
        "tool": "browser_command",
        "arguments": {
          "taskId": "$taskId",
          "action": "task_operation",
          "params": {
            "operation": "capacity"
          }
        }
      },
      "resumeCondition": "The increased policy admits another observed login page, prior input is settled and a fresh native capture selects the next step.",
      "maximumAutomaticAttempts": 1
    },
    "human_activity": {
      "rationale": "Actual recent human input or explicit takeover must be reconciled independently for every viewer before subsequent agent input.",
      "requiredActor": "active_human_viewers_and_agent",
      "evidenceRequirement": "Authoritative per-viewer activity/takeover state with qualified quiet-time evidence.",
      "inspect": {
        "tool": "browser_control",
        "arguments": {
          "taskId": "$taskId",
          "operation": "status"
        }
      },
      "remediation": [
        {
          "instruction": "Wait only for recent-input quiet time. Each explicit holder must return its retained Remote View viewer to view-only; another viewer cannot release that holder. Then obtain a fresh observation.",
          "interface": "retained_native_remote_view_view_only",
          "precondition": "Use the existing retained handoff, not a new viewer grant or identity override."
        }
      ],
      "verification": {
        "tool": "browser_control",
        "arguments": {
          "taskId": "$taskId",
          "operation": "status"
        }
      },
      "resumeCondition": "All explicit holders released, recent input is quiet and a fresh observation succeeds. Already dispatched actions remain subject to original-outcome reconciliation.",
      "maximumAutomaticAttempts": 1
    },
    "control_changed": {
      "rationale": "A changed control epoch, viewer claim or target invalidates the old control request.",
      "requiredActor": "caller",
      "evidenceRequirement": "Current control epoch, retained viewer claim and exact task briefing.",
      "inspect": {
        "tool": "browser_control",
        "arguments": {
          "taskId": "$taskId",
          "operation": "status"
        }
      },
      "remediation": [
        {
          "instruction": "Refresh control state and briefing; use the current epoch and the same authenticated viewer identity for a supported control operation. Missing claims require the native viewer flow, not impersonation.",
          "call": {
            "tool": "browser_command",
            "arguments": {
              "taskId": "$taskId",
              "action": "task_briefing"
            }
          },
          "precondition": "Old control request is not replayed blindly."
        }
      ],
      "verification": {
        "tool": "browser_control",
        "arguments": {
          "taskId": "$taskId",
          "operation": "status"
        }
      },
      "resumeCondition": "Current viewer/target/epoch match the intended request and required holder authority is present.",
      "maximumAutomaticAttempts": 1
    }
  },
