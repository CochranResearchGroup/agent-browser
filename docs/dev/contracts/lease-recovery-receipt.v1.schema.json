{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/lease-recovery-receipt.v1.schema.json",
  "title": "Agent Browser strict lease recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "requestDigest",
    "idempotencyKey",
    "operation",
    "resource",
    "claimId",
    "principalId",
    "recoveryControllerId",
    "recoveryControllerRevision",
    "previousClaimRevision",
    "claimRevision",
    "previousFencingToken",
    "fencingToken",
    "authorityRevision",
    "expiresAt",
    "transitionDeadline",
    "ownerGeneration",
    "terminalResult",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-browser.lease-recovery-receipt.v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "requestDigest": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "operation": { "const": "recover" },
    "resource": { "$ref": "lease-recovery-authorization.v4.schema.json#/$defs/resource" },
    "claimId": { "type": "string", "minLength": 1 },
    "principalId": { "type": "string", "minLength": 1 },
    "recoveryControllerId": { "type": "string", "minLength": 1 },
    "recoveryControllerRevision": { "type": "integer", "minimum": 1 },
    "previousClaimRevision": { "type": "integer", "minimum": 1 },
    "claimRevision": { "type": "integer", "minimum": 1 },
    "previousFencingToken": { "type": "integer", "minimum": 1 },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "authorityRevision": { "type": "integer", "minimum": 1 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "transitionDeadline": { "type": "string", "format": "date-time" },
    "ownerGeneration": { "type": ["integer", "null"], "minimum": 1 },
    "terminalResult": { "const": "recovered" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
