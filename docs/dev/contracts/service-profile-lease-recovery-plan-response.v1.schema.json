{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/service-profile-lease-recovery-plan-response.v1.schema.json",
  "title": "Agent Browser strict profile lease recovery plan response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "leaseId",
    "leaseRevision",
    "effectState",
    "plan",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-browser.lease-recovery-plan-response.v1" },
    "planId": { "type": "string", "minLength": 1 },
    "leaseId": { "type": "string", "minLength": 1 },
    "leaseRevision": { "type": "string", "minLength": 1 },
    "effectState": { "const": "no_effect" },
    "plan": { "$ref": "lease-recovery-authorization.v4.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
