{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-browser.local/contracts/p158-external-handoff-fixtures.v1.schema.json",
  "title":"Plan 0158 synthetic external handoff sessions",
  "type":"object",
  "required":["schemaVersion","planId","syntheticOnly","sessions"],
  "properties":{
    "schemaVersion":{"const":"agent-browser.p158-external-handoff-fixtures.v1"},
    "planId":{"const":"P158"},
    "syntheticOnly":{"const":true},
    "sessions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/session"}}
  },
  "additionalProperties":false,
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":200},
    "dateTime":{"type":["string","null"],"format":"date-time"},
    "urlRole":{"enum":["starting_handoff","location_header","iframe_src","form_action","websocket_endpoint","reconnect_target","copied_action","error_action","provider_external_url","route_binding","local_embed_url","dashboard_embed_url","health_url"]},
    "findingCode":{"enum":["external_vantage_unproven","invalid_handoff_url","non_https_url","loopback_url_leak","private_network_url_leak","link_local_url_leak","local_domain_url_leak","raw_guacamole_url_leak","forbidden_role_url_leak","dns_failure","tls_failure","redirect_failure","cookie_failure","iframe_failure","form_action_failure","websocket_failure","reconnect_failure","operator_not_ready","pixels_before_ready","visible_identity_mismatch","handoff_changed","duplicate_cold_launch","capture_gap"]},
    "identity":{
      "type":"object",
      "required":["browserId","profileId","sessionId","tabId","targetId","visibleUrl","pageMarker","pixelHash"],
      "properties":{
        "browserId":{"$ref":"#/$defs/id"},"profileId":{"$ref":"#/$defs/id"},"sessionId":{"$ref":"#/$defs/id"},"tabId":{"$ref":"#/$defs/id"},"targetId":{"$ref":"#/$defs/id"},
        "visibleUrl":{"type":"string","format":"uri"},"pageMarker":{"$ref":"#/$defs/id"},"pixelHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      },"additionalProperties":false
    },
    "session":{
      "type":"object",
      "required":["fixtureId","description","externalVantage","initialHandoffId","initialHandoffUrl","operatorVisibleState","readyObservedAt","firstUsablePixelsAt","expectedIdentity","urlObservations","ingressChecks","reconnects","captureGaps","expectedFindingCodes"],
      "properties":{
        "fixtureId":{"$ref":"#/$defs/id"},"description":{"type":"string","minLength":1},
        "externalVantage":{"$ref":"#/$defs/externalVantage"},
        "initialHandoffId":{"$ref":"#/$defs/id"},"initialHandoffUrl":{"type":"string","minLength":1},
        "operatorVisibleState":{"enum":["pending","ready","failed","expired"]},
        "readyObservedAt":{"$ref":"#/$defs/dateTime"},"firstUsablePixelsAt":{"$ref":"#/$defs/dateTime"},
        "expectedIdentity":{"$ref":"#/$defs/identity"},
        "urlObservations":{"type":"array","items":{"$ref":"#/$defs/urlObservation"}},
        "ingressChecks":{"type":"array","items":{"$ref":"#/$defs/ingressCheck"}},
        "reconnects":{"type":"array","items":{"$ref":"#/$defs/reconnect"}},
        "captureGaps":{"type":"array","items":{"$ref":"#/$defs/captureGap"}},
        "expectedFindingCodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/findingCode"}}
      },"additionalProperties":false
    },
    "externalVantage":{
      "type":"object","required":["runnerId","outsideServiceHost","outsideServiceNetworkNamespace","publicEgressObserved"],
      "properties":{"runnerId":{"$ref":"#/$defs/id"},"outsideServiceHost":{"type":"boolean"},"outsideServiceNetworkNamespace":{"type":"boolean"},"publicEgressObserved":{"type":"boolean"}},"additionalProperties":false
    },
    "urlObservation":{
      "type":"object","required":["observationId","role","url","navigable","source"],
      "properties":{"observationId":{"$ref":"#/$defs/id"},"role":{"$ref":"#/$defs/urlRole"},"url":{"type":"string","minLength":1},"navigable":{"type":"boolean"},"source":{"enum":["external_client","dashboard","provider","service_response","clipboard","error_ui"]}},"additionalProperties":false
    },
    "ingressCheck":{
      "type":"object","required":["checkId","kind","state","targetUrl","resolvedAddresses","observedAt","detail"],
      "properties":{"checkId":{"$ref":"#/$defs/id"},"kind":{"enum":["dns","tls","redirect","cookie","websocket","iframe","form_action","reconnect"]},"state":{"enum":["passed","failed","not_observed"]},"targetUrl":{"type":"string","minLength":1},"resolvedAddresses":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"observedAt":{"type":"string","format":"date-time"},"detail":{"type":["string","null"],"minLength":1}},"additionalProperties":false
    },
    "reconnect":{
      "type":"object","required":["reconnectId","handoffId","handoffUrl","state","operatorVisibleState","readyObservedAt","firstUsablePixelsAt","physicalBrowserLaunchCount","identity"],
      "properties":{"reconnectId":{"$ref":"#/$defs/id"},"handoffId":{"$ref":"#/$defs/id"},"handoffUrl":{"type":"string","minLength":1},"state":{"enum":["passed","failed"]},"operatorVisibleState":{"enum":["pending","ready","failed","expired"]},"readyObservedAt":{"$ref":"#/$defs/dateTime"},"firstUsablePixelsAt":{"$ref":"#/$defs/dateTime"},"physicalBrowserLaunchCount":{"type":"integer","minimum":0},"identity":{"$ref":"#/$defs/identity"}},"additionalProperties":false
    },
    "captureGap":{
      "type":"object","required":["gapId","evidenceClass","detail"],
      "properties":{"gapId":{"$ref":"#/$defs/id"},"evidenceClass":{"enum":["har","console","websocket","navigation","tls","video","screenshot","input_timing","pixels","identity"]},"detail":{"type":"string","minLength":1}},"additionalProperties":false
    }
  }
}
