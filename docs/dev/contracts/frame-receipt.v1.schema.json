{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/frame-receipt.v1.schema.json",
  "title": "agent-browser desktop frame receipt",
  "description": "Content-addressed receipt for one bounded ephemeral desktop frame.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "frameId",
    "schemaVersion",
    "contextId",
    "captureProvider",
    "providerVersion",
    "sequence",
    "capturedAt",
    "width",
    "height",
    "scaleFactor",
    "geometryEpoch",
    "mimeType",
    "byteLength",
    "sha256",
    "freshness",
    "retention",
    "persisted"
  ],
  "properties": {
    "frameId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "v1" },
    "contextId": { "type": "string", "minLength": 1 },
    "captureProvider": { "type": "string", "minLength": 1 },
    "providerVersion": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "scaleFactor": { "type": "number", "exclusiveMinimum": 0 },
    "geometryEpoch": { "type": "string", "minLength": 1 },
    "mimeType": { "const": "image/png" },
    "byteLength": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "freshness": { "type": "string", "minLength": 1 },
    "retention": { "const": "ephemeral" },
    "persisted": { "const": false }
  }
}
