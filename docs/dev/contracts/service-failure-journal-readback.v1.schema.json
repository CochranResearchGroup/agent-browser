{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/service-failure-journal-readback.v1.schema.json",
  "title": "Service failure journal readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records", "malformedLineCount", "writeFailureCount"],
  "properties": {
    "schemaVersion": { "const": "agent-browser.service-failure-journal-readback.v1" },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "service-failure-record.v1.schema.json" }
    },
    "malformedLineCount": { "type": "integer", "minimum": 0 },
    "writeFailureCount": { "type": "integer", "minimum": 0 },
    "deliveryOverloadCount": { "type": "integer", "minimum": 0 },
    "deliveryFailureCount": { "type": "integer", "minimum": 0 },
    "pendingRecordCount": { "type": "integer", "minimum": 0 }
  }
}
