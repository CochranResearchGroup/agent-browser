{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/interaction-receipt.v1.schema.json",
  "title": "agent-browser desktop interaction receipt",
  "description": "Privacy-safe receipt for one guarded synthetic desktop interaction. Frame bytes, visualization bytes, raw OCR text, plaintext keyboard content, full motion paths, provider stderr, filesystem paths, and provider URLs are excluded.",
  "type": "object",
  "required": [
    "schemaVersion",
    "transactionId",
    "recipeId", "recipeVersion", "recipeSha256", "operationId",
    "operationRequestSha256", "recipeProviderId", "recipeProviderVersion",
    "recipeProviderCapability",
    "replayState", "promptDisposition", "humanHandoff", "entryGate", "effectKeyDigest",
    "effectKeyCount", "attemptedEffectKeyDigest", "attemptedEffectKeyCount",
    "acknowledgedEffectKeyDigest", "acknowledgedEffectKeyCount",
    "attemptedEventOrderSha256", "browserId",
    "displayAllocationId", "streamId", "routeId", "controllerEpoch",
    "authorityDigest", "actorDigest", "beforeContextId", "beforeFrameId",
    "beforeFrameSha256", "beforeObservationId", "beforeObservationSha256",
    "selectedCandidateId", "surfaceIdentityDigest", "browserProcessIdentityDigest",
    "pointerStart", "target", "coordinateMapping", "motionProfile",
    "controlPointDigest", "emittedPathSha256", "pointerEventCount", "durationMs",
    "acknowledgementIds", "cleanupState", "textLength", "textSha256",
    "afterContextId", "afterFrameId", "afterFrameSha256", "afterObservationId",
    "afterObservationSha256", "verificationState", "effectState", "stopReason",
    "retention", "persistedPixels"
  ],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "transactionId": { "type": "string", "minLength": 1 },
    "recipeId": { "enum": ["p110-pointer-keyboard-v1", "p110-foundation-stress-v1"] },
    "recipeVersion": { "type": "string", "minLength": 1 },
    "recipeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "browserId": { "type": "string", "minLength": 1 },
    "displayAllocationId": { "type": "string", "minLength": 1 },
    "streamId": { "type": "string", "minLength": 1 },
    "routeId": { "type": "string", "minLength": 1 },
    "controllerEpoch": { "type": "integer", "minimum": 1 },
    "authorityDigest": { "type": "string", "minLength": 1 },
    "actorDigest": { "type": "string", "minLength": 1 },
    "beforeContextId": { "type": "string", "minLength": 1 },
    "beforeFrameId": { "type": "string", "minLength": 1 },
    "beforeFrameSha256": { "type": "string", "minLength": 1 },
    "beforeObservationId": { "type": "string", "minLength": 1 },
    "beforeObservationSha256": { "type": "string", "minLength": 1 },
    "selectedCandidateId": { "type": "string", "minLength": 1 },
    "surfaceIdentityDigest": { "type": "string", "minLength": 1 },
    "browserProcessIdentityDigest": { "type": "string", "minLength": 1 },
    "pointerStart": { "$ref": "#/$defs/point" },
    "target": { "$ref": "#/$defs/point" },
    "coordinateMapping": { "type": "string", "minLength": 1 },
    "motionProfile": { "type": "string", "minLength": 1 },
    "controlPointDigest": { "type": "string", "minLength": 1 },
    "emittedPathSha256": { "type": "string", "minLength": 1 },
    "pointerEventCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "acknowledgementIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cleanupState": { "type": "string", "minLength": 1 },
    "textLength": { "type": "integer", "minimum": 0, "maximum": 32 },
    "textSha256": { "type": "string", "minLength": 1 },
    "afterContextId": { "type": ["string", "null"] },
    "afterFrameId": { "type": ["string", "null"] },
    "afterFrameSha256": { "type": ["string", "null"] },
    "afterObservationId": { "type": ["string", "null"] },
    "afterObservationSha256": { "type": ["string", "null"] },
    "effectState": {
      "enum": ["no_effect", "verified_success", "effect_uncertain", "cancelled_after_effect"]
    },
    "verificationState": { "type": "string", "minLength": 1 },
    "retention": { "const": "ephemeral" },
    "stopReason": { "type": ["string", "null"] },
    "persistedPixels": { "const": false },
    "operationId": { "type": "string", "minLength": 1 },
    "operationRequestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recipeProviderId": { "type": "string", "minLength": 1 },
    "recipeProviderVersion": { "type": "string", "minLength": 1 },
    "recipeProviderCapability": { "type": "string", "minLength": 1 },
    "replayState": { "enum": ["first_execution", "replayed_terminal"] },
    "promptDisposition": {
      "oneOf": [
        { "$ref": "#/$defs/promptDisposition" },
        { "type": "null" }
      ]
    },
    "humanHandoff": {
      "oneOf": [
        { "$ref": "#/$defs/humanHandoff" },
        { "type": "null" }
      ]
    },
    "entryGate": {
      "const": "closed_live_evidence_required",
      "description": "Per-operation receipts never open implementation. Planning-open source acceptance exists only on the separate aggregate corpus record."
    },
    "effectKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effectKeyCount": { "type": "integer", "minimum": 0 },
    "attemptedEffectKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attemptedEffectKeyCount": { "type": "integer", "minimum": 0 },
    "acknowledgedEffectKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acknowledgedEffectKeyCount": { "type": "integer", "minimum": 0 },
    "attemptedEventOrderSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "promptDisposition": {
      "type": "object",
      "required": ["state", "reasonCode", "observationSha256"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "reasonCode": { "type": "string", "minLength": 1 },
        "observationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "humanHandoff": {
      "type": "object",
      "required": ["state", "reason", "handoffId", "handoffUrl"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "handoffId": { "type": "string", "minLength": 1 },
        "handoffUrl": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
