{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/p158-campaign-manifest.v1.schema.json",
  "title": "Plan 0158 frozen campaign manifest",
  "description": "Immutable identity, schedule, safety, and evidence contract for one Plan 0158 campaign. Cross-entry uniqueness, dependency order, and seed reproducibility are checked by the campaign validator.",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "runId",
    "registrySha256",
    "controllerState",
    "candidate",
    "schedule",
    "freezePolicy",
    "safetyPolicy",
    "evidencePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-browser.p158-campaign-manifest.v1" },
    "planId": { "const": "P158" },
    "runId": { "$ref": "#/$defs/id" },
    "registrySha256": { "$ref": "#/$defs/sha256" },
    "controllerState": {
      "enum": ["prepared", "frozen", "executing", "execution_terminal", "evidence_sealed", "analyzed"]
    },
    "candidate": { "$ref": "#/$defs/candidate" },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scheduledAttempt" }
    },
    "freezePolicy": { "$ref": "#/$defs/freezePolicy" },
    "safetyPolicy": { "$ref": "#/$defs/safetyPolicy" },
    "evidencePolicy": { "$ref": "#/$defs/evidencePolicy" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "caseId": {
      "enum": [
        "A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09", "A10", "A11", "A12", "A13", "A14", "A15",
        "H01", "H02", "H03", "H04", "H05", "H06", "H07", "H08", "H09", "H10", "H11", "H12",
        "X01", "X02", "X03", "X04", "X05", "X06", "X07", "X08", "X09", "X10",
        "D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10", "D11", "D12",
        "C01", "C02", "C03", "C04", "C05"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "runId",
        "sourceCommit",
        "binarySha256",
        "dashboardSha256",
        "installedGenerationId",
        "browserExecutableSha256",
        "runtimeManifestRevision",
        "providerConfigurationRevision",
        "externalIngressDeploymentRevision",
        "fixtureRegistrySha256",
        "preparedAt",
        "frozenAt"
      ],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "dashboardSha256": { "$ref": "#/$defs/sha256" },
        "installedGenerationId": { "$ref": "#/$defs/id" },
        "browserExecutableSha256": { "$ref": "#/$defs/sha256" },
        "runtimeManifestRevision": { "$ref": "#/$defs/id" },
        "providerConfigurationRevision": { "$ref": "#/$defs/id" },
        "externalIngressDeploymentRevision": { "$ref": "#/$defs/id" },
        "fixtureRegistrySha256": { "$ref": "#/$defs/sha256" },
        "preparedAt": { "$ref": "#/$defs/dateTime" },
        "frozenAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "scheduledAttempt": {
      "type": "object",
      "required": [
        "scheduleSequence",
        "scheduleId",
        "caseId",
        "attemptId",
        "repetition",
        "seed",
        "environmentIds",
        "dependsOnAttemptIds",
        "preconditionIds",
        "stimuli",
        "evidenceProfile",
        "externalIngressRequired"
      ],
      "properties": {
        "scheduleSequence": { "type": "integer", "minimum": 0 },
        "scheduleId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/caseId" },
        "attemptId": { "$ref": "#/$defs/id" },
        "repetition": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "environmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["E0", "E1", "E2", "E3"] }
        },
        "dependsOnAttemptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "preconditionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "stimuli": {
          "type": "array",
          "items": { "$ref": "#/$defs/stimulus" }
        },
        "evidenceProfile": { "enum": ["agent", "logging", "external", "display", "dashboard", "combined"] },
        "externalIngressRequired": { "type": "boolean" },
        "scheduledStartBarrier": { "$ref": "#/$defs/id" },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "stimulus": {
      "type": "object",
      "required": ["stimulusId", "kind", "ordinal", "targetId", "parametersSha256"],
      "properties": {
        "stimulusId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "targetId": { "$ref": "#/$defs/id" },
        "parametersSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "freezePolicy": {
      "type": "object",
      "required": [
        "opportunisticRetryAllowed",
        "reactionaryRepairAllowed",
        "reactionaryCleanupAllowed",
        "sourceOrHarnessMutationAfterFreezeAllowed",
        "continueIndependentCasesAfterFailure",
        "scheduledStimuliAndTeardownOnly"
      ],
      "properties": {
        "opportunisticRetryAllowed": { "const": false },
        "reactionaryRepairAllowed": { "const": false },
        "reactionaryCleanupAllowed": { "const": false },
        "sourceOrHarnessMutationAfterFreezeAllowed": { "const": false },
        "continueIndependentCasesAfterFailure": { "const": true },
        "scheduledStimuliAndTeardownOnly": { "const": true }
      },
      "additionalProperties": false
    },
    "safetyPolicy": {
      "type": "object",
      "required": ["sampleIntervalMilliseconds", "consecutiveViolationsBeforeStop", "rules", "stopAction"],
      "properties": {
        "sampleIntervalMilliseconds": { "type": "integer", "minimum": 1 },
        "consecutiveViolationsBeforeStop": { "type": "integer", "minimum": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ruleId", "metric", "comparison", "threshold"],
            "properties": {
              "ruleId": { "$ref": "#/$defs/id" },
              "metric": { "type": "string", "minLength": 1 },
              "comparison": { "enum": ["less_than", "greater_than", "greater_than_or_equal", "equals"] },
              "threshold": { "type": "number" },
              "unit": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "stopAction": { "const": "stop_load_generator_only" }
      },
      "additionalProperties": false
    },
    "evidencePolicy": {
      "type": "object",
      "required": ["stateRoot", "appendOnly", "atomicWrites", "digestAlgorithm", "forbiddenCapturedFields"],
      "properties": {
        "stateRoot": { "type": "string", "minLength": 1 },
        "appendOnly": { "const": true },
        "atomicWrites": { "const": true },
        "digestAlgorithm": { "const": "sha256" },
        "forbiddenCapturedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
