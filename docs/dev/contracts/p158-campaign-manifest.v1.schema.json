{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/p158-campaign-manifest.v1.schema.json",
  "title": "Plan 0158 frozen campaign manifest",
  "description": "Immutable identity, schedule, safety, and evidence contract for one Plan 0158 campaign. Cross-entry uniqueness, dependency order, and seed reproducibility are checked by the campaign validator.",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "runId",
    "registrySha256",
    "controllerState",
    "candidate",
    "artifactBindings",
    "environmentSeals",
    "calibration",
    "fixtureSeal",
    "freezeContract",
    "schedule",
    "freezePolicy",
    "safetyPolicy",
    "evidencePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-browser.p158-campaign-manifest.v1" },
    "planId": { "const": "P158" },
    "runId": { "$ref": "#/$defs/id" },
    "registrySha256": { "$ref": "#/$defs/sha256" },
    "controllerState": {
      "enum": ["prepared", "frozen", "executing", "execution_terminal", "evidence_sealed", "analyzed"]
    },
    "candidate": { "$ref": "#/$defs/candidate" },
    "artifactBindings": {
      "type": "array",
      "minItems": 18,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactBinding" }
    },
    "environmentSeals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/environmentSeal" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "environmentId": { "const": "E1" } }, "required": ["environmentId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "environmentId": { "const": "E2" } }, "required": ["environmentId"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "calibration": { "$ref": "#/$defs/calibration" },
    "fixtureSeal": { "$ref": "#/$defs/fixtureSeal" },
    "freezeContract": { "$ref": "#/$defs/freezeContract" },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scheduledAttempt" }
    },
    "freezePolicy": { "$ref": "#/$defs/freezePolicy" },
    "safetyPolicy": { "$ref": "#/$defs/safetyPolicy" },
    "evidencePolicy": { "$ref": "#/$defs/evidencePolicy" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "caseId": {
      "enum": [
        "A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09", "A10", "A11", "A12", "A13", "A14", "A15",
        "H01", "H02", "H03", "H04", "H05", "H06", "H07", "H08", "H09", "H10", "H11", "H12",
        "X01", "X02", "X03", "X04", "X05", "X06", "X07", "X08", "X09", "X10",
        "D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10", "D11", "D12",
        "C01", "C02", "C03", "C04", "C05"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "runId",
        "candidateSha256",
        "sourceCommit",
        "binarySha256",
        "dashboardSha256",
        "installedGenerationId",
        "browserExecutableSha256",
        "runtimeManifestRevision",
        "providerConfigurationRevision",
        "externalIngressDeploymentRevision",
        "aggregateFixtureManifestSha256",
        "preparedAt"
      ],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "candidateSha256": { "$ref": "#/$defs/sha256" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "dashboardSha256": { "$ref": "#/$defs/sha256" },
        "installedGenerationId": { "$ref": "#/$defs/id" },
        "browserExecutableSha256": { "$ref": "#/$defs/sha256" },
        "runtimeManifestRevision": { "$ref": "#/$defs/id" },
        "providerConfigurationRevision": { "$ref": "#/$defs/id" },
        "externalIngressDeploymentRevision": { "$ref": "#/$defs/id" },
        "aggregateFixtureManifestSha256": { "$ref": "#/$defs/sha256" },
        "preparedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "artifactBinding": {
      "type": "object",
      "required": ["artifactId", "kind", "relativePath", "sha256", "byteCount", "capturedAt"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "installation_receipt", "runtime_status_receipt", "runtime_doctor_receipt", "runtime_manifest",
            "provider_plan_receipt", "provider_stage_receipt", "provider_preflight_receipt", "provider_apply_receipt",
            "provider_status_receipt", "provider_doctor_receipt", "provider_configuration",
            "external_ingress_deployment", "external_vantage", "external_handoff_oracle_report",
            "calibration_raw", "calibration_summary", "calibration_budget", "fixture_aggregate_manifest",
            "execution_schedule"
          ]
        },
        "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteCount": { "type": "integer", "minimum": 1 },
        "capturedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "environmentSeal": {
      "type": "object",
      "required": ["environmentId", "identityId", "identitySha256", "sealSha256", "sealedAt", "receiptArtifactIds"],
      "properties": {
        "environmentId": { "enum": ["E1", "E2"] },
        "identityId": { "$ref": "#/$defs/id" },
        "identitySha256": { "$ref": "#/$defs/sha256" },
        "sealSha256": { "$ref": "#/$defs/sha256" },
        "sealedAt": { "$ref": "#/$defs/dateTime" },
        "receiptArtifactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "externalClientIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "externalVantageArtifactId": { "$ref": "#/$defs/id" },
        "externalHandoffOracleArtifactId": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "environmentId": { "const": "E2" } }, "required": ["environmentId"] },
          "then": {
            "type": "object",
            "required": ["externalClientIds", "externalVantageArtifactId", "externalHandoffOracleArtifactId"],
            "properties": {
              "externalClientIds": true,
              "externalVantageArtifactId": true,
              "externalHandoffOracleArtifactId": true
            }
          },
          "else": {
            "properties": {
              "externalClientIds": false,
              "externalVantageArtifactId": false,
              "externalHandoffOracleArtifactId": false
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": [
        "calibrationId", "environmentIds", "startedAt", "completedAt", "clean",
        "workload", "rawArtifactId", "rawArtifactSha256", "summaryArtifactId",
        "summaryArtifactSha256", "budgetArtifactId", "budgetSha256", "environmentRelativeBudgets"
      ],
      "properties": {
        "calibrationId": { "$ref": "#/$defs/id" },
        "environmentIds": { "const": ["E1", "E2"] },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "completedAt": { "$ref": "#/$defs/dateTime" },
        "clean": { "const": true },
        "workload": {
          "type": "object",
          "required": ["durationMinutes", "agentClients", "externalViewers", "controllers", "serviceCommands", "dashboardActions", "handoffReconnects"],
          "properties": {
            "durationMinutes": { "const": 20 },
            "agentClients": { "const": 25 },
            "externalViewers": { "const": 2 },
            "controllers": { "const": 1 },
            "serviceCommands": { "const": 500 },
            "dashboardActions": { "const": 50 },
            "handoffReconnects": { "const": 10 }
          },
          "additionalProperties": false
        },
        "rawArtifactId": { "$ref": "#/$defs/id" },
        "rawArtifactSha256": { "$ref": "#/$defs/sha256" },
        "summaryArtifactId": { "$ref": "#/$defs/id" },
        "summaryArtifactSha256": { "$ref": "#/$defs/sha256" },
        "budgetArtifactId": { "$ref": "#/$defs/id" },
        "budgetSha256": { "$ref": "#/$defs/sha256" },
        "environmentRelativeBudgets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "fixtureSeal": {
      "type": "object",
      "required": ["aggregateArtifactId", "aggregateSha256", "entryCount", "includedPaths"],
      "properties": {
        "aggregateArtifactId": { "$ref": "#/$defs/id" },
        "aggregateSha256": { "$ref": "#/$defs/sha256" },
        "entryCount": { "type": "integer", "minimum": 1 },
        "includedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "freezeContract": {
      "type": "object",
      "required": ["freezeId", "requiredStartedCaseCount", "requiredStartedAttemptCount"],
      "properties": {
        "freezeId": { "$ref": "#/$defs/id" },
        "requiredStartedCaseCount": { "const": 0 },
        "requiredStartedAttemptCount": { "const": 0 }
      },
      "additionalProperties": false
    },
    "scheduledAttempt": {
      "type": "object",
      "required": [
        "scheduleSequence",
        "scheduleId",
        "caseId",
        "attemptId",
        "repetition",
        "seed",
        "environmentIds",
        "dependsOnAttemptIds",
        "preconditionIds",
        "stimuli",
        "evidenceProfile",
        "externalIngressRequired"
      ],
      "properties": {
        "scheduleSequence": { "type": "integer", "minimum": 0 },
        "scheduleId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/caseId" },
        "attemptId": { "$ref": "#/$defs/id" },
        "repetition": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "environmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["E0", "E1", "E2", "E3"] }
        },
        "dependsOnAttemptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "preconditionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "stimuli": {
          "type": "array",
          "items": { "$ref": "#/$defs/stimulus" }
        },
        "evidenceProfile": { "enum": ["agent", "logging", "external", "display", "dashboard", "combined"] },
        "externalIngressRequired": { "type": "boolean" },
        "scheduledStartBarrier": { "$ref": "#/$defs/id" },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "stimulus": {
      "type": "object",
      "required": ["stimulusId", "kind", "ordinal", "targetId", "parametersSha256"],
      "properties": {
        "stimulusId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "targetId": { "$ref": "#/$defs/id" },
        "parametersSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "freezePolicy": {
      "type": "object",
      "required": [
        "opportunisticRetryAllowed",
        "reactionaryRepairAllowed",
        "reactionaryCleanupAllowed",
        "sourceOrHarnessMutationAfterFreezeAllowed",
        "continueIndependentCasesAfterFailure",
        "scheduledStimuliAndTeardownOnly"
      ],
      "properties": {
        "opportunisticRetryAllowed": { "const": false },
        "reactionaryRepairAllowed": { "const": false },
        "reactionaryCleanupAllowed": { "const": false },
        "sourceOrHarnessMutationAfterFreezeAllowed": { "const": false },
        "continueIndependentCasesAfterFailure": { "const": true },
        "scheduledStimuliAndTeardownOnly": { "const": true }
      },
      "additionalProperties": false
    },
    "safetyPolicy": {
      "type": "object",
      "required": ["sampleIntervalMilliseconds", "consecutiveViolationsBeforeStop", "rules", "stopAction"],
      "properties": {
        "sampleIntervalMilliseconds": { "type": "integer", "minimum": 1 },
        "consecutiveViolationsBeforeStop": { "type": "integer", "minimum": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ruleId", "metric", "comparison", "threshold"],
            "properties": {
              "ruleId": { "$ref": "#/$defs/id" },
              "metric": { "type": "string", "minLength": 1 },
              "comparison": { "enum": ["less_than", "greater_than", "greater_than_or_equal", "equals"] },
              "threshold": { "type": "number" },
              "unit": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "stopAction": { "const": "stop_load_generator_only" }
      },
      "additionalProperties": false
    },
    "evidencePolicy": {
      "type": "object",
      "required": ["stateRoot", "appendOnly", "atomicWrites", "digestAlgorithm", "forbiddenCapturedFields"],
      "properties": {
        "stateRoot": { "type": "string", "minLength": 1 },
        "appendOnly": { "const": true },
        "atomicWrites": { "const": true },
        "digestAlgorithm": { "const": "sha256" },
        "forbiddenCapturedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
