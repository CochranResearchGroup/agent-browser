{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/service-status-response.v1.schema.json",
  "title": "agent-browser service status response",
  "description": "Stable API shape for service status responses returned by CLI JSON and HTTP service APIs.",
  "type": "object",
  "required": [
    "service_state",
    "profileAllocations",
    "manualBrowsers",
    "closedTabProjection"
  ],
  "properties": {
    "control_plane": {
      "type": "object",
      "properties": {
        "worker_state": {
          "type": "string"
        },
        "browser_health": {
          "type": "string"
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "waiting_profile_lease_job_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of retained service jobs currently waiting for profile lease release."
        },
        "service_job_timeout_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "service_monitor_interval_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Background interval in milliseconds for enqueuing due active service monitor checks. Null means disabled."
        }
      },
      "additionalProperties": true
    },
    "profileAllocations": {
      "description": "Derived service-owned profile allocation view for session holders and waiting profile-lease jobs.",
      "type": "array",
      "items": {
        "$ref": "service-profiles-response.v1.schema.json#/$defs/profileAllocation"
      }
    },
    "manualBrowsers": {
      "description": "Live detached headed runtime browsers that remain operator-visible even when no CDP endpoint is available.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "runtimeProfile",
          "profilePath",
          "pid",
          "launchMode",
          "automationAvailable",
          "remoteControlAvailable",
          "nextSafeAction"
        ],
        "properties": {
          "id": { "type": "string" },
          "runtimeProfile": { "type": "string" },
          "profilePath": { "type": "string" },
          "pid": { "type": "integer", "minimum": 1 },
          "browserFamily": { "type": ["string", "null"] },
          "browserBuild": { "type": ["string", "null"] },
          "display": { "type": ["string", "null"] },
          "launchMode": { "type": "string" },
          "targetUrl": { "type": ["string", "null"] },
          "devtoolsPort": { "type": ["integer", "null"], "minimum": 1 },
          "automationAvailable": { "type": "boolean" },
          "remoteViewRouteId": { "type": ["string", "null"] },
          "remoteViewUrl": { "type": ["string", "null"] },
          "remoteControlAvailable": { "type": "boolean" },
          "nextSafeAction": { "type": "string" },
          "startedAt": { "type": ["string", "null"] },
          "lastObservedAt": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "closedTabProjection": {
      "description": "Response-only closed-tab history projection metadata. Persisted service state remains authoritative and is not compacted by status reads.",
      "type": "object",
      "required": [
        "mode",
        "cap",
        "totalClosedCount",
        "retainedClosedCount",
        "omittedClosedCount",
        "ordering",
        "diagnosticAvailable"
      ],
      "properties": {
        "mode": { "enum": ["bounded", "full"] },
        "cap": { "type": ["integer", "null"], "minimum": 0 },
        "totalClosedCount": { "type": "integer", "minimum": 0 },
        "retainedClosedCount": { "type": "integer", "minimum": 0 },
        "omittedClosedCount": { "type": "integer", "minimum": 0 },
        "ordering": { "const": "tab_id_descending" },
        "diagnosticAvailable": { "const": true }
      },
      "additionalProperties": false
    },
    "retainedDisplayAllocations": {
      "description": "Derived retained display-allocation classification summary. These records are historical service-state records and are not live control rows unless classified as live.",
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "applySafeCount": { "type": "integer", "minimum": 0 },
        "retainedCount": { "type": "integer", "minimum": 0 },
        "classCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "applySafeIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "retainedIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidateReasons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "explanation": { "type": "string" },
        "cleanupCommand": { "type": "string" }
      },
      "additionalProperties": true
    },
    "browserSessionAuthority": {
      "description": "Read-only daemon authority snapshot that reconciles modeled browser rows with process/resource truth before clients present browsers as viable.",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "availability": { "enum": ["available", "partial", "unknown"] },
        "summary": {
          "type": "object",
          "properties": {
            "modeledBrowserCount": { "type": "integer", "minimum": 0 },
            "viableBrowserCount": { "type": "integer", "minimum": 0 },
            "attentionBrowserCount": { "type": "integer", "minimum": 0 },
            "nonViableBrowserCount": { "type": "integer", "minimum": 0 }
            ,"unknownBrowserCount": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "resourcePressure": {
          "type": "object",
          "properties": {
            "state": { "type": "string" },
            "totalProcessCount": { "type": "integer", "minimum": 0 },
            "correlatedProcessCount": { "type": "integer", "minimum": 0 },
            "candidateCount": { "type": "integer", "minimum": 0 },
            "protectedCount": { "type": "integer", "minimum": 0 },
            "observedCount": { "type": "integer", "minimum": 0 },
            "observedUnownedAgentBrowserProcessCount": { "type": "integer", "minimum": 0 },
            "candidateRssBytes": { "type": "integer", "minimum": 0 },
            "totalRssBytes": { "type": "integer", "minimum": 0 },
            "reasons": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "browserVerdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "browserId": { "type": "string" },
              "state": { "type": "string" },
              "viable": { "type": "boolean" },
              "needsAttention": { "type": "boolean" },
              "reasons": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "launchConfig": {
      "description": "No-launch diagnostic view of the configured browser build and executable path that service-owned requests would inherit.",
      "type": "object",
      "required": [
        "defaultBrowserBuild",
        "stealthCdpChromiumRequired",
        "stealthCdpChromiumReady",
        "executablePath",
        "executablePathSource",
        "executablePathExists",
        "browserBuildManifests",
        "profileSmoke",
        "warnings"
      ],
      "properties": {
        "defaultBrowserBuild": {
          "type": ["string", "null"],
          "description": "Configured service.defaultBrowserBuild value, or null when stock Chrome remains the default posture."
        },
        "stealthCdpChromiumRequired": {
          "type": "boolean",
          "description": "True when the service default or at least one site policy selects stealthcdp_chromium."
        },
        "stealthCdpChromiumReady": {
          "type": "boolean",
          "description": "True when stealthcdp_chromium is not selected, or it has a configured executable path that exists."
        },
        "executablePath": {
          "type": ["string", "null"],
          "description": "Resolved executablePath from config, AGENT_BROWSER_EXECUTABLE_PATH, or a browser build manifest."
        },
        "executablePathSource": {
          "type": ["string", "null"],
          "description": "Source of the resolved executablePath: env, config, manifest, or null when auto-discovery remains in use."
        },
        "executablePathExists": {
          "type": ["boolean", "null"],
          "description": "Whether the resolved executablePath exists as a file. Null means no explicit executable path is configured."
        },
        "browserBuildManifests": {
          "type": "object",
          "description": "Resolved browser-build manifest diagnostics keyed by browser build id, such as stealthcdp_chromium.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "manifestPath": { "type": ["string", "null"] },
              "manifestExists": { "type": "boolean" },
              "manifestValid": { "type": "boolean" },
              "ready": { "type": "boolean" },
              "artifactDir": { "type": ["string", "null"] },
              "artifactName": { "type": ["string", "null"] },
              "schema": { "type": ["string", "null"] },
              "chromeVersion": { "type": ["string", "null"] },
              "chromiumSha": { "type": ["string", "null"] },
              "patchsetSha": { "type": ["string", "null"] },
              "executablePath": { "type": ["string", "null"] },
              "executablePathExists": { "type": "boolean" },
              "executableSha256": { "type": ["string", "null"] },
              "smokePath": { "type": ["string", "null"] },
              "smokeSuccess": { "type": ["boolean", "null"] },
              "navigatorWebdriver": { "type": ["string", "null"] },
              "warnings": { "type": "array" }
            },
            "additionalProperties": true
          }
        },
        "profileSmoke": {
          "type": "object",
          "description": "No-launch recommendation for validating WSL to Windows chromium-stealthcdp profile writes after the executable and manifest are ready.",
          "required": [
            "available",
            "command",
            "reason",
            "isWsl",
            "executableOnWindowsMount",
            "description"
          ],
          "properties": {
            "available": {
              "type": "boolean",
              "description": "True when this host is WSL, stealthcdp_chromium is selected and ready, and the resolved executable is on a Windows mount."
            },
            "command": {
              "type": "string",
              "description": "Repo command that runs the live profile-write smoke."
            },
            "reason": {
              "type": "string",
              "description": "Machine-readable readiness reason for why the smoke is or is not available."
            },
            "isWsl": {
              "type": "boolean",
              "description": "Whether the service process appears to be running under WSL."
            },
            "executableOnWindowsMount": {
              "type": "boolean",
              "description": "Whether the resolved executable path is under /mnt/<drive>/ and therefore needs WSL path translation for Windows Chrome arguments."
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of what the smoke validates."
            }
          },
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "statusProjection": {
      "description": "Typed provenance and freshness for host-local observations attached to the authoritative Service Status projection. Older v1 servers may omit this additive field.",
      "type": "object",
      "required": ["schemaVersion", "authority", "observations"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "authority": {
          "type": "object",
          "required": ["source", "projectedAt"],
          "properties": {
            "source": { "const": "reconciled_service_state" },
            "projectedAt": { "type": "string" }
          },
          "additionalProperties": false
        },
        "observations": {
          "type": "object",
          "required": [
            "state", "source", "sourceHostId", "observedAt", "validUntil",
            "maxAgeMs", "manualBrowsersState", "browserProcessState", "errors", "viewStreams"
          ],
          "properties": {
            "state": { "enum": ["complete", "partial", "unavailable"] },
            "source": {
              "enum": [
                "local_status_observation_adapter",
                "unavailable_status_observation_adapter",
                "in_memory_status_observation_adapter"
              ]
            },
            "sourceHostId": {
              "type": ["string", "null"],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "observedAt": { "type": ["string", "null"] },
            "validUntil": { "type": ["string", "null"] },
            "maxAgeMs": { "type": "integer", "minimum": 0 },
            "manualBrowsersState": { "enum": ["observed", "partial", "unavailable"] },
            "browserProcessState": { "enum": ["observed", "partial", "unavailable"] },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code", "subject", "message"],
                "properties": {
                  "code": {
                    "enum": [
                      "display_probe_timeout", "display_probe_unsupported",
                      "display_probe_unavailable", "display_probe_failed",
                      "runtime_profile_unavailable", "process_inventory_unavailable",
                      "configured_route_unavailable"
                    ]
                  },
                  "subject": { "type": "string" },
                  "message": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "viewStreams": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "browserId", "streamId", "state", "observedAt", "validUntil",
                  "maxAgeMs", "routePresentation", "displayContent"
                ],
                "properties": {
                  "browserId": { "type": "string" },
                  "streamId": { "type": "string" },
                  "state": { "enum": ["observed", "timed_out", "unsupported", "unavailable", "failed"] },
                  "observedAt": { "type": ["string", "null"] },
                  "validUntil": { "type": ["string", "null"] },
                  "maxAgeMs": { "type": "integer", "minimum": 0 },
                  "routePresentation": {
                    "oneOf": [
                      { "type": "null" },
                      {
                        "type": "object",
                        "required": ["frameUrl", "externalUrl", "source"],
                        "properties": {
                          "frameUrl": { "type": "string" },
                          "externalUrl": { "type": "string" },
                          "source": { "enum": ["route_descriptor", "retained_stream", "configured_client_url"] }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "displayContent": { "type": ["object", "null"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimeLifecycle": {
      "description": "Shared runtime lifecycle readback for multiplicity, owner state, reconciliation, retention, resource pressure, cleanup obligations, and blocking incidents. Older v1 servers may omit this additive field.",
      "type": "object",
      "required": [
        "schemaVersion", "ready", "state", "observedAtEpochMs", "multiplicity",
        "lifecycle", "reconciliation", "resources", "cleanupObligations",
        "retention", "incident"
      ],
      "properties": {
        "schemaVersion": { "const": "agent-browser.runtime-lifecycle-status.v1" },
        "ready": { "type": "boolean" },
        "state": { "type": "string" },
        "observedAtEpochMs": { "type": ["integer", "null"], "minimum": 0 },
        "multiplicity": { "type": ["object", "null"], "additionalProperties": true },
        "lifecycle": {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "registryRevision": { "type": "integer", "minimum": 0 },
            "ownerCount": { "type": "integer", "minimum": 0 },
            "recordCount": { "type": "integer", "minimum": 0 },
            "lifecycleStateCounts": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "cleanupObligationStateCounts": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          },
          "additionalProperties": true
        },
        "reconciliation": { "type": ["object", "null"], "additionalProperties": true },
        "resources": { "type": ["object", "null"], "additionalProperties": true },
        "cleanupObligations": { "type": ["object", "null"], "additionalProperties": true },
        "retention": {
          "type": "object",
          "required": ["profiles", "generations"],
          "properties": {
            "profiles": { "type": ["object", "null"], "additionalProperties": true },
            "generations": { "type": ["object", "null"], "additionalProperties": true }
          },
          "additionalProperties": false
        },
        "incident": { "type": ["object", "null"], "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "service_state": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
