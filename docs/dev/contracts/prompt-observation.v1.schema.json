{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/prompt-observation.v1.schema.json",
  "title": "agent-browser synthetic desktop prompt observation",
  "description": "Bounded prompt-perception evidence over repository-owned desktop and independently rendered page fixtures. This contract proves only absence from fixture page inputs and never live CDP blindness.",
  "type": "object",
  "required": [
    "observationId", "schemaVersion", "contextId", "frameId", "frameSha256",
    "geometryEpoch", "coordinateSpace", "promptProfileId", "profileVersion",
    "profileSha256", "targetClass", "surfaceIdentityDigest",
    "browserProcessIdentityDigest", "detectorReceipts", "candidates",
    "detectionStatus", "pageVisibility", "classification", "handlingOutcome",
    "selectedCandidateId", "blindnessReceipt", "observedAtMs", "evidenceAgeMs",
    "retention", "persistedPixels"
  ],
  "properties": {
    "observationId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "v1" },
    "contextId": { "type": "string", "minLength": 1 },
    "frameId": { "type": "string", "minLength": 1 },
    "frameSha256": { "$ref": "#/$defs/sha256" },
    "geometryEpoch": { "type": "string", "minLength": 1 },
    "coordinateSpace": { "const": "desktop_physical_pixels" },
    "promptProfileId": { "const": "p110-external-prompt-v1" },
    "profileVersion": { "type": "string", "minLength": 1 },
    "profileSha256": { "$ref": "#/$defs/sha256" },
    "targetClass": { "const": "synthetic_browser_external_confirmation" },
    "surfaceIdentityDigest": { "$ref": "#/$defs/sha256" },
    "browserProcessIdentityDigest": { "$ref": "#/$defs/sha256" },
    "detectorReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "detectorId", "version", "evidenceSha256", "normalizationVersion",
          "matchCount", "threshold"
        ],
        "properties": {
          "detectorId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "evidenceSha256": { "$ref": "#/$defs/sha256" },
          "normalizationVersion": { "type": "string", "minLength": 1 },
          "matchCount": { "type": "integer", "minimum": 0 },
          "threshold": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidateId", "targetClass", "rank", "bounds", "center", "score",
          "disposition"
        ],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "targetClass": { "const": "synthetic_browser_external_confirmation" },
          "rank": { "type": "integer", "minimum": 1 },
          "bounds": { "$ref": "#/$defs/rectangle" },
          "center": { "$ref": "#/$defs/point" },
          "score": { "type": "integer", "minimum": 0 },
          "disposition": { "enum": ["actionable", "manual_only"] }
        },
        "additionalProperties": false
      }
    },
    "detectionStatus": { "enum": ["matched", "not_found", "ambiguous"] },
    "pageVisibility": { "enum": ["absent", "present", "indeterminate"] },
    "classification": { "enum": ["browser_external", "page_surface", "unclassified"] },
    "handlingOutcome": {
      "enum": ["actionable_observation", "operator_intervention_required", "none"]
    },
    "selectedCandidateId": { "type": ["string", "null"] },
    "blindnessReceipt": { "$ref": "#/$defs/blindnessReceipt" },
    "operatorIntervention": { "$ref": "#/$defs/operatorIntervention" },
    "observedAtMs": { "type": "integer", "minimum": 0 },
    "evidenceAgeMs": { "type": "integer", "minimum": 0, "maximum": 750 },
    "retention": { "const": "ephemeral" },
    "persistedPixels": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rectangle": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blindnessReceipt": {
      "type": "object",
      "required": [
        "proofClass", "claim", "desktopFrameSha256", "pageFrameSha256",
        "domManifestSha256", "promptSignatureSha256", "bindingSha256",
        "desktopPromptMatchCount", "pageScreenshotPromptMatchCount",
        "domPromptMatchCount", "correspondenceState"
      ],
      "properties": {
        "proofClass": { "const": "repository_fixture" },
        "claim": { "const": "absent_from_fixture_page_inputs" },
        "desktopFrameSha256": { "$ref": "#/$defs/sha256" },
        "pageFrameSha256": { "$ref": "#/$defs/sha256" },
        "domManifestSha256": { "$ref": "#/$defs/sha256" },
        "promptSignatureSha256": { "$ref": "#/$defs/sha256" },
        "bindingSha256": { "$ref": "#/$defs/sha256" },
        "desktopPromptMatchCount": { "type": "integer", "minimum": 0 },
        "pageScreenshotPromptMatchCount": { "type": "integer", "minimum": 0 },
        "domPromptMatchCount": { "type": "integer", "minimum": 0 },
        "correspondenceState": { "const": "verified" }
      },
      "additionalProperties": false
    },
    "operatorIntervention": {
      "type": "object",
      "required": ["state", "reasonCode", "title", "message", "actions"],
      "properties": {
        "state": { "const": "required" },
        "reasonCode": { "const": "synthetic_prompt_requires_operator_review" },
        "title": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind", "safety", "description"],
            "properties": {
              "id": { "const": "review_in_remote_view" },
              "label": { "type": "string", "minLength": 1 },
              "kind": { "const": "operator_instruction" },
              "safety": { "const": "safe" },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
