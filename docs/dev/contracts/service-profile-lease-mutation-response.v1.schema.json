{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/service-profile-lease-mutation-response.v1.schema.json",
  "title": "agent-browser service profile lease mutation response",
  "type": "object",
  "required": ["operation", "lease", "previousLeaseRevision", "leaseRevision", "principalId", "profileId", "appliedAt"],
  "properties": {
    "operation": { "type": "string", "enum": ["rejoin", "renew", "release"] },
    "lease": { "$ref": "service-profile-lease-record.v1.schema.json" },
    "previousLeaseRevision": { "type": "string" },
    "leaseRevision": { "type": "string" },
    "principalId": { "type": "string" },
    "profileId": { "type": "string" },
    "appliedAt": { "type": "string", "format": "date-time" },
    "replayed": { "type": "boolean" },
    "canonicalTerminalReceipt": {
      "type": "object",
      "required": ["schemaVersion", "receiptId", "requestDigest", "idempotencyKey", "operation", "resource", "claimId", "principalId", "capabilityId", "capabilityRevision", "claimRevision", "releasedFencingToken", "terminalFencingToken", "authorityRevision", "terminalResult", "occurredAt"],
      "properties": {
        "schemaVersion": { "const": "agent-browser.lease-terminal-receipt.v1" },
        "receiptId": { "type": "string" },
        "requestDigest": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "operation": { "const": "release" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string" },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "claimId": { "type": "string" },
        "principalId": { "type": "string" },
        "capabilityId": { "type": "string" },
        "capabilityRevision": { "type": "integer", "minimum": 1 },
        "claimRevision": { "type": "integer", "minimum": 1 },
        "releasedFencingToken": { "type": "integer", "minimum": 1 },
        "terminalFencingToken": { "type": "integer", "minimum": 1 },
        "authorityRevision": { "type": "integer", "minimum": 1 },
        "terminalResult": { "const": "released" },
        "occurredAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
